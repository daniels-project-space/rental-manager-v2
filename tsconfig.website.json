{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".next/cache/website.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/pages/**/*.ts",
    "src/pages/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/hooks/**/*.ts",
    "src/*.ts",
    "src/*.tsx",
    "src/**/*.d.ts",
    "*.d.ts",
    "middleware.ts",
    "proxy.ts",
    "instrumentation.ts",
    "instrumentation-client.ts",
    "mdx-components.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.*",
    "**/*.spec.*",
    "**/__tests__/**",
    "graphify-out",
    ".trigger"
  ]
}
