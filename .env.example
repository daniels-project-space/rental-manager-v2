# Set after running `npx convex dev` once
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Poller self-healing — configure the same secret in Vercel and Convex.
# POLL_TRIGGER_URL=https://<your-production-domain>/api/poll-hygglo
# POLL_TRIGGER_SECRET=

# Project-hub vault (anonymous-queryable read endpoint)
VAULT_URL=https://fantastic-roadrunner-485.convex.cloud

# READ-ONLY safety rail — never set to "true" outside Phase 7 cutover
ALLOW_HYGGLO_SEND=false
